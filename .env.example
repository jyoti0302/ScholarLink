# Database Configuration
DATABASE_URL=sqlite:///./data/processed/professor_discovery.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/professor_discovery

# OpenAlex & Crossref API Configuration
OPENALEX_EMAIL=research_user@example.com
CROSSREF_MAILTO=research_user@example.com

# Collection Settings
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_DELAY_SECONDS=0.5
MAX_PUBLICATIONS_PER_PROFESSOR=15

# Review and Verification Settings
DATA_DIR=./data
AUTO_APPROVE_HIGH_CONFIDENCE=false

# Student Authentication (Stage 5.2)
# Generate a strong random secret (>= 32 characters), e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Access token lifetime in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# Optional AI Resume Tailoring Provider (Stage 6.2 - reuses existing Gemini pattern)
# Keep this strictly server-side; never expose API keys to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

